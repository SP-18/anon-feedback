# App runtime connection. Must connect as WRITER_ROLE, the INSERT-only role.
DATABASE_URL=postgres://feedback_writer:replace-with-writer-password@localhost:5432/anon_feedback
# Owner/admin connection, used only by `npm run migrate`. Keep it off the app server.
MIGRATION_DATABASE_URL=postgres://localhost:5432/anon_feedback
# INSERT-only role the app runs as. Created and granted by `npm run migrate`.
WRITER_ROLE=feedback_writer
# Optional (dev convenience): if set, `npm run migrate` sets the writer role's password to this.
# Preferred for production: leave unset and run `\password feedback_writer` in psql as the owner.
WRITER_PASSWORD=replace-with-writer-password
# Shared code everyone in the organisation uses to unlock the form. Rotating it logs everyone out.
ACCESS_CODE=change-me
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
